# trader-edge environment configuration
#
# Copy this file to `.env` (in the same directory as this file) and fill in
# the values you need. The `.env` file is git-ignored.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Groww API access token (required for live data)
#
# Get one from: https://groww.in -> Settings -> Trade API -> Generate token.
# Without this, the engine falls back to the deterministic mock provider.
# ---------------------------------------------------------------------------
GROWW_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Provider override (optional)
#
# auto  - use Groww if GROWW_ACCESS_TOKEN is set, else mock  (default)
# mock  - always use the offline mock provider, even if a token is set
# groww - always use the live Groww client, error if no token
# ---------------------------------------------------------------------------
TRADER_EDGE_PROVIDER=auto

# ---------------------------------------------------------------------------
# Groww REST base URL (optional)
#
# Override only if Groww publishes a sandbox or you are routing through a
# proxy. Leave blank to use the production endpoint.
# ---------------------------------------------------------------------------
GROWW_API_BASE_URL=

# ---------------------------------------------------------------------------
# Trade log path (optional)
#
# Where every `analyze` verdict is appended for personal calibration tracking.
# Defaults to ~/.trader_edge/log.csv. Set to a project-local path if you want
# the log version-controlled with the rest of your trading notes.
# ---------------------------------------------------------------------------
TRADER_EDGE_LOG_PATH=
